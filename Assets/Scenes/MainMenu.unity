      m_Calls: []
  m_text: "1. \u0412\u0456\u0434\u043A\u0440\u0438\u0439 \u0421\u0425\u0412\u0410\u0422\u041A\u0410.\n2.
    \u041E\u0431\u0435\u0440\u0438 \u0440\u0435\u0436\u0438\u043C \u0437 \u0431\u043E\u0442\u0430\u043C\u0438
    \u0430\u0431\u043E \u043C\u0435\u0440\u0435\u0436\u0435\u0432\u0438\u0439.\n3.
    \u0412\u0438\u0431\u0435\u0440\u0438 \u043A\u0430\u0440\u0442\u0443, slot, \u043A\u043E\u043C\u0430\u043D\u0434\u0443,
    \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0441\u0442\u044C AI \u0456 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0456
    \u0440\u0435\u0441\u0443\u0440\u0441\u0438.\n4. \u041D\u0430\u0442\u0438\u0441\u043D\u0438
    \u0417\u0410\u041F\u0423\u0421\u041A."
  m_isRightToLeft: 0
